{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npx @tailwindcss/cli -i static/css/input.css -o static/css/output.css --minify && go generate ./...",
  "outputDirectory": "static",
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/*.go": {
      "runtime": "go@1.24"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api"
    }
  ]
}
