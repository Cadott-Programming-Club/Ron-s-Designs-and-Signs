# Copy this file to .envrc and edit with your values
# Then run: direnv allow

# Database (SQLite)
export DATABASE_URL="./data/ronsdesigns.db"

# Server
export PORT="8000"
export ENV="development"
export LOG_LEVEL="DEBUG"

# Site / SEO (used for meta tags, OG, etc.)
export SITE_NAME="Ron's Designs and Signs"
export SITE_URL="http://localhost:8000"
export DEFAULT_OG_IMAGE="/static/images/og-default.png"

# Brevo (email service) - Get your API key from https://brevo.com
export BREVO_API_KEY="YOUR_BREVO_API_KEY_HERE"
export CONTACT_EMAIL="ronsdesigns@hotmail.com"
