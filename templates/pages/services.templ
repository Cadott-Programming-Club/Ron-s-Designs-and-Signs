package pages

import (
	"github.com/BubblePlayzTHEREAL/Ron-s-Designs-and-Signs/pkg/meta"
	"github.com/BubblePlayzTHEREAL/Ron-s-Designs-and-Signs/templates/layouts"
)

templ Services() {
	@layouts.Base(meta.New("Services", "Custom signs, vinyl graphics, apparel, and logo design services in Cadott, Wisconsin")) {
		<!-- Header Banner -->
		<section class="services-banner">
			<div class="container">
				<h1 class="services-banner-title">
					<span class="animate-word" data-delay="0">What</span>
					<span class="animate-word" data-delay="100">We</span>
					<span class="animate-word" data-delay="200">Create</span>
				</h1>
				<p class="services-banner-subtitle">
					<span class="animate-word" data-delay="300">From</span>
					<span class="animate-word" data-delay="400">concept</span>
					<span class="animate-word" data-delay="500">to</span>
					<span class="animate-word" data-delay="600">completion</span>
				</p>
			</div>
		</section>
		<!-- Interactive Service Cards -->
		<section class="container">
			<div class="service-cards">
				<!-- Card 1: Custom Signs -->
				<div class="service-card" data-card="1">
					<div class="service-card-inner">
						<div class="service-card-front">
							<div class="service-card-icon">
								<svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
									<rect x="3" y="3" width="18" height="18" rx="2"/>
									<path d="M3 9h18M9 21V9"/>
								</svg>
							</div>
							<h3 class="service-card-title">Custom Signs</h3>
							<p class="service-card-brief">Professional signage for businesses and events</p>
							<button class="service-card-flip-btn">Learn More →</button>
						</div>
						<div class="service-card-back">
							<h3 class="service-card-title-back">Custom Signs</h3>
							<ul class="service-card-features">
								<li>✓ Storefront signs</li>
								<li>✓ Outdoor banners</li>
								<li>✓ Yard signs</li>
								<li>✓ Event signage</li>
								<li>✓ Channel letters</li>
							</ul>
							<a href="/gallery" class="service-card-cta">View Examples</a>
							<button class="service-card-flip-btn">← Back</button>
						</div>
					</div>
				</div>
				<!-- Card 2: Vinyl Graphics -->
				<div class="service-card" data-card="2">
					<div class="service-card-inner">
						<div class="service-card-front">
							<div class="service-card-icon">
								<svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
									<rect x="2" y="7" width="20" height="14" rx="2"/>
									<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
								</svg>
							</div>
							<h3 class="service-card-title">Vinyl Graphics</h3>
							<p class="service-card-brief">Vehicle wraps and custom decals</p>
							<button class="service-card-flip-btn">Learn More →</button>
						</div>
						<div class="service-card-back">
							<h3 class="service-card-title-back">Vinyl Graphics</h3>
							<ul class="service-card-features">
								<li>✓ Vehicle wraps</li>
								<li>✓ Window graphics</li>
								<li>✓ Wall decals</li>
								<li>✓ Custom lettering</li>
								<li>✓ Brand graphics</li>
							</ul>
							<a href="/gallery" class="service-card-cta">View Examples</a>
							<button class="service-card-flip-btn">← Back</button>
						</div>
					</div>
				</div>
				<!-- Card 3: Custom Apparel -->
				<div class="service-card" data-card="3">
					<div class="service-card-inner">
						<div class="service-card-front">
							<div class="service-card-icon">
								<svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
									<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h-9v8.27c.6.34 1 .99 1 1.73 0 1.1-.9 2-2 2s-2-.9-2-2c0-.74.4-1.39 1-1.73V14H1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73 0-1.1.9-2 2-2z"/>
								</svg>
							</div>
							<h3 class="service-card-title">Custom Apparel</h3>
							<p class="service-card-brief">Personalized clothing for teams and businesses</p>
							<button class="service-card-flip-btn">Learn More →</button>
						</div>
						<div class="service-card-back">
							<h3 class="service-card-title-back">Custom Apparel</h3>
							<ul class="service-card-features">
								<li>✓ T-shirts</li>
								<li>✓ Hoodies</li>
								<li>✓ Team uniforms</li>
								<li>✓ Business apparel</li>
								<li>✓ Event merchandise</li>
							</ul>
							<a href="/gallery" class="service-card-cta">View Examples</a>
							<button class="service-card-flip-btn">← Back</button>
						</div>
					</div>
				</div>
				<!-- Card 4: Logo Design -->
				<div class="service-card" data-card="4">
					<div class="service-card-inner">
						<div class="service-card-front">
							<div class="service-card-icon">
								<svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
									<path d="M12 2L2 7l10 5 10-5-10-5z"/>
									<path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
								</svg>
							</div>
							<h3 class="service-card-title">Logo Design</h3>
							<p class="service-card-brief">Brand identity creation and refinement</p>
							<button class="service-card-flip-btn">Learn More →</button>
						</div>
						<div class="service-card-back">
							<h3 class="service-card-title-back">Logo Design</h3>
							<ul class="service-card-features">
								<li>✓ Logo creation</li>
								<li>✓ Brand identity</li>
								<li>✓ Logo refinement</li>
								<li>✓ Vector files</li>
								<li>✓ Brand guidelines</li>
							</ul>
							<a href="/contact" class="service-card-cta">Get Started</a>
							<button class="service-card-flip-btn">← Back</button>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- Process Timeline -->
		<section class="container">
			<h2 class="section-title gradient-text-cinematic">Our Process</h2>
			<div class="timeline">
				<div class="timeline-item">
					<div class="timeline-number">1</div>
					<div class="timeline-content">
						<h3 class="timeline-title">Consultation</h3>
						<p class="timeline-description">We discuss your vision, requirements, and budget to understand exactly what you need.</p>
					</div>
				</div>
				<div class="timeline-connector"></div>
				<div class="timeline-item">
					<div class="timeline-number">2</div>
					<div class="timeline-content">
						<h3 class="timeline-title">Design</h3>
						<p class="timeline-description">Our team creates mockups and designs, working with you until it's perfect.</p>
					</div>
				</div>
				<div class="timeline-connector"></div>
				<div class="timeline-item">
					<div class="timeline-number">3</div>
					<div class="timeline-content">
						<h3 class="timeline-title">Production</h3>
						<p class="timeline-description">We bring your design to life using premium materials and expert craftsmanship.</p>
					</div>
				</div>
				<div class="timeline-connector"></div>
				<div class="timeline-item">
					<div class="timeline-number">4</div>
					<div class="timeline-content">
						<h3 class="timeline-title">Installation</h3>
						<p class="timeline-description">Professional installation ensures your signage looks perfect and lasts for years.</p>
					</div>
				</div>
			</div>
		</section>
		<!-- Portfolio Teaser -->
		<section class="container">
			<h2 class="section-title gradient-text-energy">See Our Work</h2>
			<div class="portfolio-teaser">
				<div class="portfolio-teaser-item">
					<img src="/images/work/awaken_marine.webp" alt="Awaken Marine Storefront Sign" loading="lazy" class="portfolio-teaser-image"/>
					<div class="portfolio-teaser-overlay">
						<span class="portfolio-teaser-label">Storefront Signs</span>
					</div>
				</div>
				<div class="portfolio-teaser-item">
					<img src="/images/work/agusta_farm.webp" alt="Agusta Farm Vehicle Graphics" loading="lazy" class="portfolio-teaser-image"/>
					<div class="portfolio-teaser-overlay">
						<span class="portfolio-teaser-label">Vehicle Graphics</span>
					</div>
				</div>
				<div class="portfolio-teaser-item">
					<img src="/images/work/casa_poblana_shirt.webp" alt="Custom Apparel" loading="lazy" class="portfolio-teaser-image"/>
					<div class="portfolio-teaser-overlay">
						<span class="portfolio-teaser-label">Custom Apparel</span>
					</div>
				</div>
				<div class="portfolio-teaser-item">
					<img src="/images/work/jacobsons.webp" alt="Jacobson's Sign" loading="lazy" class="portfolio-teaser-image"/>
					<div class="portfolio-teaser-overlay">
						<span class="portfolio-teaser-label">Business Signs</span>
					</div>
				</div>
				<div class="portfolio-teaser-item">
					<img src="/images/work/fox_den.webp" alt="Foxx Den Lighted Sign" loading="lazy" class="portfolio-teaser-image"/>
					<div class="portfolio-teaser-overlay">
						<span class="portfolio-teaser-label">Lighted Signs</span>
					</div>
				</div>
				<div class="portfolio-teaser-item">
					<img src="/images/work/rivian.webp" alt="Rivian Vehicle Graphics" loading="lazy" class="portfolio-teaser-image"/>
					<div class="portfolio-teaser-overlay">
						<span class="portfolio-teaser-label">Premium Wraps</span>
					</div>
				</div>
			</div>
			<div class="portfolio-teaser-cta">
				<a href="/gallery" class="btn-primary">
					View Full Gallery
					<svg class="btn-icon" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</a>
			</div>
		</section>
		@servicesScripts()
	}
}

templ servicesScripts() {
	<script>
		// Animated words on load
		document.addEventListener('DOMContentLoaded', () => {
			const words = document.querySelectorAll('.animate-word');
			words.forEach(word => {
				const delay = parseInt(word.dataset.delay || '0');
				setTimeout(() => {
					word.style.opacity = '1';
					word.style.transform = 'translateY(0)';
				}, delay);
			});
		});

		// Service card flip
		const cards = document.querySelectorAll('.service-card');
		cards.forEach(card => {
			const flipBtns = card.querySelectorAll('.service-card-flip-btn');
			flipBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					card.classList.toggle('flipped');
				});
			});
		});

		// Timeline animation on scroll
		const observerOptions = {
			threshold: 0.2,
			rootMargin: '0px 0px -100px 0px'
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
				}
			});
		}, observerOptions);

		document.querySelectorAll('.timeline-item').forEach(item => {
			observer.observe(item);
		});

		document.querySelectorAll('.portfolio-teaser-item').forEach(item => {
			observer.observe(item);
		});
	</script>
}
